<!DOCTYPE html>
<html lang="nl">

<head>
    {{> header }}
    <link rel="stylesheet" href="css/products.css">
</head>

<body>

    {{> nav }}

    <section class="products">
        <div class="container">
            <h1>Bestellen</h1>

            <div class="product-grid" id="productGrid">

                {{#products }}
                <div class="product-card" data-id="{{ product_id }}">
                    <div class="product-img">
                        <img src="images/products/{{image}}" alt="{{ product_title }}"
                            onerror="this.style.display='none'; this.parentNode.querySelector('.img-fallback').style.display='flex';">
                        <div class="img-fallback" style="display:none;">x</div>
                    </div>
                    <div class="product-info">
                        <div>
                            <div class="product-title">{{ product_title}}</div>
                            <div class="product-desc">{{ product_desc }}</div>
                        </div>
                        <div class="price-order-row">
                            <div class="price">{{ price }}</div>

                            <div class="actions-right">
                                <div class="qty-wrap">
                                    <button class="qty-btn" data-action="minus" aria-label="Minder">−</button>
                                    <input type="number" class="qty-input" value="1" min="1" max="99" inputmode="numeric">
                                    <button class="qty-btn" data-action="plus" aria-label="Meer">+</button>
                                </div>

                                <button class="btn-order" data-add="1">
                                    <svg class="cart-svg" viewBox="0 0 24 24">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                    <span class="plus-badge">+</span>
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
                {{/products}}

            </div>

            <div class="cart-summary">
                <div class="cart-header">
                    <span class="left">
                        <svg viewBox="0 0 24 24">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        Jouw bestelling
                    </span>
                    <span id="cartCountLabel" style="font-size:0.85rem; font-weight:500; color:#8b7a6c;">0 items</span>
                </div>

                <ul class="cart-items" id="cartItemsList">
                    <li class="empty-cart">Nog geen broodjes gekozen</li>
                </ul>

                <!-- Totaal + knop op één rij -->
                <div class="cart-total-row">
                    <button class="btn-checkout" id="checkoutBtn" aria-label="Afrekenen">
                        <svg viewBox="0 0 24 24">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </button>
                    <div class="cart-total">
                        <span>Totaal</span>
                        <span class="total-price" id="cartTotal">€0,00</span>
                    </div>
                </div>
                
            </div>
        </div>
    </section>

<script>
(function () {
    /* ---------- Configuratie ---------- */
    /*
    const products = {
        1: { name: 'Pandesal klassiek', price: 2.50 },
        2: { name: 'Pandesal met roomboter', price: 3.20 },
        3: { name: 'Pandesal met knoflook', price: 3.50 },
        4: { name: 'Pandesal met kaas', price: 3.80 },
        5: { name: 'Pandesal met ui', price: 3.30 }
    };
    */
    
    const products = {{{ js_products_json }}};
    const STORAGE_KEY = 'kimBelsCart';

    /* ---------- localStorage helpers ---------- */
    function loadCart() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return {};
            const parsed = JSON.parse(raw);
            // Basisvalidatie: alleen objecten met geldige product-id's
            if (typeof parsed !== 'object' || parsed === null) return {};
            const cleaned = {};
            for (const [id, qty] of Object.entries(parsed)) {
                const n = Number(qty);
                if (products[id] && Number.isFinite(n) && n > 0) {
                    cleaned[id] = Math.min(99, Math.floor(n));
                }
            }
            return cleaned;
        } catch (err) {
            console.warn('Kon winkelwagen niet laden:', err);
            return {};
        }
    }

    function saveCart(cart) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
        } catch (err) {
            // Bijv. privémodus of quota overschreden
            console.warn('Kon winkelwagen niet opslaan:', err);
        }
    }

    /* ---------- State ---------- */
    let cart = loadCart();   // ← direct uit localStorage

    /* ---------- DOM ---------- */
    const cartCountEl = document.getElementById('cart-count');
    const cartCountLabel = document.getElementById('cartCountLabel');
    const cartItemsList = document.getElementById('cartItemsList');
    const cartTotalEl = document.getElementById('cartTotal');
    const checkoutBtn = document.getElementById('checkoutBtn');

    /* ---------- Helpers ---------- */
    function formatPrice(price) {
        return '€' + price.toFixed(2).replace('.', ',');
    }

    /* ---------- UI updaten ---------- */
    function updateUI() {
        let totalItems = 0;
        let totalPrice = 0;
        const itemsArray = [];

        for (const [id, qty] of Object.entries(cart)) {
            if (qty > 0) {
                const product = products[id];
                if (product) {
                    totalItems += qty;
                    totalPrice += product.price * qty;
                    itemsArray.push({
                        id: id,
                        name: product.name,
                        qty: qty,
                        subtotal: product.price * qty
                    });
                }
            }
        }

        // Badge in navbar (op elke pagina)
        if (cartCountEl) cartCountEl.textContent = totalItems;

        // Label in cart-summary
        if (cartCountLabel) {
            cartCountLabel.textContent = totalItems + (totalItems === 1 ? ' item' : ' items');
        }

        // Lijst met items
        if (cartItemsList) {
            if (itemsArray.length === 0) {
                cartItemsList.innerHTML = '<li class="empty-cart">Nog geen broodjes gekozen</li>';
            } else {
                let html = '';
                itemsArray.forEach(item => {
                    html += `<li class="cart-item">
                        <span class="cart-item-name">${item.name} <span class="cart-item-qty">×${item.qty}</span></span>
                        <span class="cart-item-price">${formatPrice(item.subtotal)}</span>
                        <button class="cart-item-remove" data-remove="${item.id}" aria-label="Verwijder">✕</button>
                    </li>`;
                });
                cartItemsList.innerHTML = html;
            }
        }

        // Totaal
        if (cartTotalEl) cartTotalEl.textContent = formatPrice(totalPrice);
    }

    /* ---------- Cart mutaties ---------- */
    function setCart(newCart) {
        cart = newCart;
        saveCart(cart);     // ← elke wijziging direct opslaan
        updateUI();
    }

    function addToCart(productId, qty) {
        const id = String(productId);
        if (!products[id]) return;
        const newCart = { ...cart };
        newCart[id] = Math.min(99, (newCart[id] || 0) + qty);
        setCart(newCart);
    }

    function removeFromCart(productId) {
        const id = String(productId);
        if (!cart[id]) return;
        const newCart = { ...cart };
        delete newCart[id];
        setCart(newCart);
    }

    /* ---------- Aantal-knoppen (+ / −) ---------- */
    document.querySelectorAll('.qty-wrap').forEach(wrap => {
        const input = wrap.querySelector('.qty-input');
        const minus = wrap.querySelector('[data-action="minus"]');
        const plus = wrap.querySelector('[data-action="plus"]');

        minus.addEventListener('click', () => {
            let val = parseInt(input.value, 10) || 1;
            if (val > 1) input.value = val - 1;
        });

        plus.addEventListener('click', () => {
            let val = parseInt(input.value, 10) || 1;
            if (val < 99) input.value = val + 1;
        });

        input.addEventListener('input', () => {
            let val = parseInt(input.value, 10);
            if (isNaN(val) || val < 1) input.value = 1;
            if (val > 99) input.value = 99;
        });

        input.addEventListener('blur', () => {
            if (!input.value || parseInt(input.value, 10) < 1) input.value = 1;
        });
    });

    /* ---------- Bestelknoppen ---------- */
    document.querySelectorAll('.btn-order').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const productId = btn.getAttribute('data-add');
            const card = btn.closest('.product-card');
            const input = card ? card.querySelector('.qty-input') : null;
            const qty = input ? (parseInt(input.value, 10) || 1) : 1;

            addToCart(productId, qty);

            if (input) input.value = 1;

            // Korte feedback
            btn.style.background = '#7a3d1a';
            setTimeout(() => { btn.style.background = ''; }, 200);
        });
    });

    /* ---------- Verwijderen uit winkelwagen ---------- */
    if (cartItemsList) {
        cartItemsList.addEventListener('click', (e) => {
            const removeBtn = e.target.closest('[data-remove]');
            if (removeBtn) {
                removeFromCart(removeBtn.getAttribute('data-remove'));
            }
        });
    }

    /* ---------- Afrekenen ---------- */
    if (checkoutBtn) {
        checkoutBtn.addEventListener('click', () => {
            let totalItems = 0;
            for (const qty of Object.values(cart)) totalItems += qty;

            if (totalItems === 0) {
                alert('Voeg eerst wat broodjes toe aan je bestelling.');
            } else {
                alert(`Bedankt! Je bestelling van ${totalItems} broodjes is geplaatst. We gaan direct voor je bakken! 🥖`);
                setCart({});   // ← leegmaken én opslaan
            }
        });
    }

    /* ---------- Fallback voor afbeeldingen ---------- */
    document.querySelectorAll('.product-img img').forEach(img => {
        img.addEventListener('error', function () {
            this.style.display = 'none';
            const fallback = this.parentNode.querySelector('.img-fallback');
            if (fallback) fallback.style.display = 'flex';
        });
    });

    /* ---------- Sync tussen tabbladen (optioneel) ---------- */
    window.addEventListener('storage', (e) => {
        if (e.key === STORAGE_KEY) {
            cart = loadCart();
            updateUI();
        }
    });

    /* ---------- Init ---------- */
    updateUI();
})();
</script>

</body>

  {{> footer }}

</html>