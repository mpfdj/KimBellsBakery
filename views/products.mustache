<!DOCTYPE html>
<html lang="nl">
<head>
    {{> header }}
    <link rel="stylesheet" href="css/products.css">
</head>
<body>

{{> nav }}

<section class="products">
    <div class="container">
        <h1>Bestellen</h1>

        <div class="product-grid" id="productGrid">
            {{#products}}
            <div class="product-card" data-id="{{ product_id }}">
                <div class="product-img">
                    <img src="images/products/{{image}}" alt="{{ product_title }}"
                         onerror="this.style.display='none'; this.parentNode.querySelector('.img-fallback').style.display='flex';">
                    <div class="img-fallback" style="display:none;">x</div>
                </div>
                <div class="product-info">
                    <div>
                        <div class="product-title">{{ product_title }}</div>
                        <div class="product-unit">{{ product_unit }}</div>
                    </div>
                    <div class="price-order-row">
                        <div class="price">{{ price }}</div>

                        <div class="actions-right">
                            <div class="qty-wrap">
                                <button class="qty-btn" data-action="minus" aria-label="Minder">−</button>
                                <input type="number" class="qty-input" value="1" min="1" max="99" inputmode="numeric">
                                <button class="qty-btn" data-action="plus" aria-label="Meer">+</button>
                            </div>

                            <button class="btn-order" data-add="{{ product_id }}">
                                <svg class="cart-svg" viewBox="0 0 24 24">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                <span class="plus-badge">+</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            {{/products}}
        </div>
    </div>
</section>

<script>
    window.products = {{{ js_products_json }}};
</script>
<script src="js/cart.js" defer></script>
<script>
    (function () {
        document.querySelectorAll('.qty-wrap').forEach(wrap => {
            const input = wrap.querySelector('.qty-input');
            const minus = wrap.querySelector('[data-action="minus"]');
            const plus = wrap.querySelector('[data-action="plus"]');

            minus.addEventListener('click', () => {
                let val = parseInt(input.value, 10) || 1;
                if (val > 1) input.value = val - 1;
            });

            plus.addEventListener('click', () => {
                let val = parseInt(input.value, 10) || 1;
                if (val < 99) input.value = val + 1;
            });

            input.addEventListener('input', () => {
                let val = parseInt(input.value, 10);
                if (isNaN(val) || val < 1) input.value = 1;
                if (val > 99) input.value = 99;
            });

            input.addEventListener('blur', () => {
                if (!input.value || parseInt(input.value, 10) < 1) input.value = 1;
            });
        });

        document.querySelectorAll('.btn-order').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const productId = btn.getAttribute('data-add');
                const card = btn.closest('.product-card');
                const input = card ? card.querySelector('.qty-input') : null;
                const qty = input ? (parseInt(input.value, 10) || 1) : 1;

                window.Cart.addToCart(productId, qty);

                if (input) input.value = 1;

                btn.style.background = '#7a3d1a';
                setTimeout(() => { btn.style.background = ''; }, 200);
            });
        });

        document.querySelectorAll('.product-img img').forEach(img => {
            img.addEventListener('error', function () {
                this.style.display = 'none';
                const fallback = this.parentNode.querySelector('.img-fallback');
                if (fallback) fallback.style.display = 'flex';
            });
        });
    })();
</script>

</body>
{{> footer }}
</html>