<!DOCTYPE html>
<html lang="nl">

<head>
    {{> header }}
    <link rel="stylesheet" href="css/contact.css">
</head>

<body>

    {{> nav }}

    <section class="contact-section">
        <div class="container">
            
            <h1>Contact</h1>
            <p class="subtitle">Heb je vragen, een speciale bestelling of wil je iets anders weten? Ik hoor het graag!</p>

            <!-- Bericht weergave -->
            <div id="alert" class="alert"></div>


            <div class="contact-form">
                <h2>Stuur een bericht</h2>
                <form id="contactForm" action="https://miel-de-jaeger.nl/KimBellsBakery/send_message.php" method="POST">

                    <div class="honeypot">
                        <label for="website">Website</label>
                        <input type="text" id="website" name="website" placeholder="Laat dit veld leeg" tabindex="-1" autocomplete="off">
                        <p style="color: #999; font-size: 12px;">Laat dit veld leeg</p>
                    </div>

                    <div class="honeypot">
                        <label>
                            <input type="checkbox" name="newsletter" value="1">
                            Schrijf mij in voor de nieuwsbrief (optioneel)
                        </label>
                    </div>

                    <input type="hidden" name="form_timestamp" id="form_timestamp" value="">

                    <script>
                        document.getElementById('form_timestamp').value = Math.floor(Date.now() / 1000);
                    </script>



                    <div class="form-row">
                        <div class="form-group">
                            <label for="name">Naam</label>
                            <input type="text" id="name" name="name" placeholder="Jouw naam" required>
                        </div>
                        <div class="form-group">
                            <label for="email">E-mail</label>
                            <input type="email" id="email" name="email" placeholder="Jouw e-mail" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="subject">Onderwerp *</label>
                        <select id="subject" name="subject" required>
                            <option value="">Kies een onderwerp...</option>
                            <option value="bestelling">Bestelling</option>
                            <option value="trouwtaart">Taart</option>
                            <option value="allergie">Allergie</option>
                            <option value="feedback">Feedback</option>
                            <option value="overig">Overig</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="message">Bericht *</label>
                        <textarea id="message" name="message" placeholder="Waarmee kunnen we je helpen?" required></textarea>
                    </div>

                    <button type="submit" class="btn-submit">Verstuur bericht</button>
                </form>
            </div>

        </div>
    </section>


    <script>
        // Toon eventuele berichten van de URL parameters
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const status = urlParams.get('status');
            const message = urlParams.get('message');
            const alertDiv = document.getElementById('alert');

            if (status && message) {
                alertDiv.className = 'alert alert-' + status;
                alertDiv.textContent = decodeURIComponent(message);
                alertDiv.style.display = 'block';

                // Verwijder de parameters uit de URL zonder de pagina te herladen
                if (window.history && window.history.replaceState) {
                    const newUrl = window.location.pathname + window.location.hash;
                    window.history.replaceState({}, document.title, newUrl);
                }
            }
        });
    </script>

</body>

    {{> footer }}

</html>